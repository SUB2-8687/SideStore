    "View remaining days until your active apps expire. Tap the countdown timers to refresh them in the background." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 앱이 만료될 때까지 남은 일수를 확인합니다. 카운트다운 타이머를 탭하면 백그라운드에서 새로고침합니다."
          }
        }
      }
    },
