    "Sign Out": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃"
          }
        }
      }
    },
    "Sign in with your Apple ID to download apps from SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore에서 앱을 다운로드하려면 Apple 계정으로 로그인하세요."
          }
        }
      }
    },
    "Signature & Public Key Details": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 및 공개 키 세부 정보"
          }
        }
      }
    },
    "Signature Algorithm": {
      "localizations": {
        "ko": {
          "stringUnit": {
