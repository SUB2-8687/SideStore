    "The app you are installing has a bundle ID (%@) that does not match the active app (%@). Would you like to proceed?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The app you are installing has a bundle ID (%1$@) that does not match the active app (%2$@). Would you like to proceed?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하려는 앱의 번들 ID(%1$@)가 활성 앱(%2$@)과 일치하지 않습니다. 계속하시겠습니까?"
          }
        }
      }
    },
    "The app's Info.plist could not be found.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 Info.plist를 찾을 수 없습니다."
          }
        }
      }
    },
    "The app's Info.plist could not be found: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 Info.plist를 찾을 수 없습니다: %@"
          }
        }
      }
    },
    "The bundle ID does not match the one specified by the source.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들 ID가 저장소에서 지정한 것과 일치하지 않습니다."
          }
        }
      }
    },
    "The bundle ID “%@” does not match the one specified by the source (“%@”).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The bundle ID “%1$@” does not match the one specified by the source (“%2$@”)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들 ID “%1$@”이(가) 저장소에서 지정한 것(“%2$@”)과 일치하지 않습니다."
          }
        }
      }
    },
    "The cached permissions for %@ do not match the source.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 캐시된 권한이 저장소와 일치하지 않습니다."
          }
        }
      }
    },
    "The cached versions for %@ do not match the source.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 캐시된 버전이 저장소와 일치하지 않습니다."
          }
        }
      }
    },
    "The current pairing file is invalid or missing.\n\nPlease make sure to input a valid pairing file! If the issue persists, replace your pairing with iloader.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 페어링 파일이 잘못되었거나 없습니다.\n\n유효한 페어링 파일을 입력했는지 확인해 주세요! 문제가 계속되면 iloader로 페어링을 다시 설정하세요."
          }
        }
      }
    },
    "The current pairing file is invalid or missing. Reason: %@\n\nPlease make sure to input a valid pairing file! If the issue persists, replace your pairing with iloader.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 페어링 파일이 잘못되었거나 없습니다. 이유: %@\n\n유효한 페어링 파일을 입력했는지 확인해 주세요! 문제가 계속되면 iloader로 페어링을 다시 설정하세요."
          }
        }
      }
    },
    "The current pairing file is invalid. Reason: %@\n\nPlease make sure to input a valid pairing file! If the issue persists, replace your pairing with iloader or idevice_pair.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 페어링 파일이 올바르지 않습니다. 이유: %@\n\n올바른 페어링 파일을 입력했는지 확인하세요! 문제가 계속되면 iloader 또는 idevice_pair로 페어링을 교체하세요."
          }
        }
      }
    },
    "The database on disk was created with a newer version of SideStore. Downgrading the database schema is not supported. Please update SideStore or reset your database.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크의 데이터베이스는 더 최신 버전의 SideStore로 생성되었습니다. 데이터베이스 스키마 다운그레이드는 지원되지 않습니다. SideStore를 업데이트하거나 데이터베이스를 재설정하세요."
          }
        }
      }
    },
    "The default SideStore source cannot be removed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 SideStore 저장소는 제거할 수 없습니다."
          }
        }
      }
    },
    "The dependency '%@' could not be downloaded.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종속성 ‘%@’을(를) 다운로드하지 못했습니다."
          }
        }
      }
    },
    "The device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기"
          }
        }
      }
    },
    "The disk is incompatible with %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크가 %@과(와) 호환되지 않습니다."
          }
        }
      }
    },
    "The downloaded version of %@ does not match the build number specified by the source.\nExpected version: %@\nFound version: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The downloaded version of %1$@ does not match the build number specified by the source.\nExpected version: %2$@\nFound version: %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 %1$@ 버전이 저장소에서 지정한 빌드 번호와 일치하지 않습니다.\n예상 버전: %2$@\n발견된 버전: %3$@"
          }
        }
      }
    },
    "The downloaded version of %@ does not match the version specified by the source.\nExpected version: %@\nFound version: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The downloaded version of %1$@ does not match the version specified by the source.\nExpected version: %2$@\nFound version: %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 %1$@ 버전이 저장소에서 지정한 버전과 일치하지 않습니다.\n예상 버전: %2$@\n발견된 버전: %3$@"
          }
        }
      }
    },
    "The file size of %@ (%@) does not match the size specified by the source (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The file size of %1$@ (%2$@) does not match the size specified by the source (%3$@)."
          }
        },
        "ko": {
