          }
        }
      }
    },
    "The process": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스"
          }
        }
      }
    },
    "The process '%@'": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 '%@'"
          }
        }
