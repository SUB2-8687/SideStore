            "value": "서명 알고리즘"
          }
        }
      }
    },
    "Signatures & Certificates (%d)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 및 인증서 (%d)"
          }
        }
      }
    },
    "Signed HMAC token dynamically calculated by ADI engine per request": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청마다 ADI 엔진이 동적으로 계산하는 서명된 HMAC 토큰"
