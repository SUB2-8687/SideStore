      }
    },
    "The provided anisette data is invalid.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공된 Anisette 데이터가 유효하지 않습니다."
          }
        }
      }
    },
    "The provisioning profile for SideStore is missing or invalid.": {
      "localizations": {
        "ko": {
