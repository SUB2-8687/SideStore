    },
    "The requested app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 앱"
          }
        }
      }
    },
    "The selected certificate is already being used for this app. Please use the Resign option instead.": {
      "localizations": {
