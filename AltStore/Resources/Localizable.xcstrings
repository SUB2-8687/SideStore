    },
    "The selected file is a certificate, not a private key.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일은 인증서이며, 개인 키가 아닙니다."
          }
        }
      }
    },
    "The selected pairing file is invalid or not usable. Please select a valid pairing file.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 페어링 파일이 유효하지 않거나 사용할 수 없습니다. 유효한 페어링 파일을 선택하세요."
          }
        }
      }
    },
    "The signing certificate could not be extracted from SideStore's binary.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 바이너리에서 서명 인증서를 추출할 수 없습니다."
          }
        }
      }
    },
    "The signing certificate used to install SideStore has expired.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore를 설치할 때 사용한 서명 인증서가 Apple Developer 포털에서 폐기되었습니다."
          }
        }
      }
    },
    "The signing certificate used to install SideStore was revoked on the Apple Developer portal.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore를 설치할 때 사용한 서명 인증서가 Apple Developer 포털에서 폐기되었습니다."
          }
        }
      }
    },
    "The signing certificate used to install “%@” differs from your active signing certificate. Please re-sign or reinstall the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 앱을 설치할 때 사용한 서명 인증서가 현재 활성 서명 인증서와 다릅니다. 앱을 다시 서명하거나 재설치해 주세요."
          }
        }
      }
    },
    "The signing certificate used to install “%@” has expired. Please re-sign or reinstall the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 앱을 설치할 때 사용한 서명 인증서가 만료되었습니다. 앱을 다시 서명하거나 재설치해 주세요."
          }
        }
      }
    },
    "The signing certificate used to install “%@” was revoked on the Apple Developer portal. Please re-sign or reinstall the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 앱을 설치할 때 사용한 서명 인증서가 Apple Developer 포털에서 폐기되었습니다. 앱을 다시 서명하거나 재설치해 주세요."
          }
        }
      }
    },
    "The source “%@” contains %@ for %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The source “%1$@” contains %2$@ for %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 “%1$@”에 %3$@에 대한 %2$@이(가) 포함되어 있습니다."
          }
        }
      }
    },
    "The source “%@” contains multiple apps with %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The source “%1$@” contains multiple apps with %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 “%1$@”에 %2$@인 앱이 여러 개 포함되어 있습니다."
          }
        }
      }
    },
    "The source “%@” contains notarized apps, which are not supported by this version of SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 “%@”에 공증된 앱이 포함되어 있으며, 이는 이 버전의 SideStore에서 지원하지 않습니다."
          }
        }
      }
    },
    "The source “%@” has been blocked by SideStore for security reasons.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 저장소는 보안상의 이유로 SideStore에서 차단되었습니다."
          }
        }
      }
    },
    "The source “%@” is not added to SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 저장소가 SideStore에 추가되어 있지 않습니다."
          }
        }
      }
    },
    "The source “%@” is not supported by this version of SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 저장소는 이 버전의 SideStore에서 지원하지 않습니다."
          }
        }
      }
    },
    "Theme Manager": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 관리자"
          }
        }
      }
    },
    "There are no SideStore sources.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 저장소가 없습니다."
          }
        }
      }
    },
    "There are no active sideloaded apps to refresh.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로고침할 활성 사이드로드 앱이 없습니다."
          }
        }
      }
    },
    "There was an error connecting to the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 연결하는 중 오류가 발생했습니다."
          }
        }
      }
    },
    "There was an issue communicating with the usbmuxd daemon.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "usbmuxd 데몬과 통신하는 중 문제가 발생했습니다."
          }
        }
      }
    },
    "These are permissions required by “%@” that SideStore does not recognize. Make sure you understand them before continuing.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음은 “%@”에서 요구하지만 SideStore가 인식하지 못하는 권한입니다. 계속하기 전에 내용을 이해했는지 확인하세요."
          }
        }
      }
    },
    "These permissions must be declared by the source in order for SideStore to install this app:": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 이 앱을 설치하려면 저장소에서 다음 권한을 선언해야 합니다:"
          }
        }
      }
    },
    "These updates don't support iOS %@. Please update your device to the latest iOS version to install them.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업데이트는 iOS %@을(를) 지원하지 않습니다. 설치하려면 기기를 최신 iOS 버전으로 업데이트하세요."
          }
        }
      }
    },
    "This certificate is already revoked on Apple's servers.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인증서는 이미 Apple 서버에서 폐기되었습니다."
          }
        }
      }
    },
    "This certificate type requires a paid Apple Developer account.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인증서 유형은 유료 Apple Developer 계정이 필요합니다."
          }
        }
      }
    },
    "This device is running iOS %@, but %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This device is running iOS %1$@, but %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 iOS %1$@을(를) 실행 중이지만, %2$@"
          }
        }
      }
    },
    "This item will be permanently removed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 영구적으로 제거됩니다."
          }
        }
      }
    },
    "This provisioning profile contains %@ developer certificate(s), but none match any signing certificates in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로비저닝 프로파일에는 개발자 인증서 %@개가 들어 있지만, SideStore의 어떤 서명 인증서와도 일치하지 않습니다.\n\n계속하면 개인 키가 있는 일치하는 서명 인증서를 가져오기 전까지 이 프로파일은 앱 서명에 사용할 수 없습니다."
          }
        }
      }
    },
    "This provisioning profile contains %lld developer certificate(s), but none match any signing certificates in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로비저닝 프로파일에는 개발자 인증서 %lld개가 들어 있지만, SideStore의 어떤 서명 인증서와도 일치하지 않습니다.\n\n계속하면 개인 키가 있는 일치하는 서명 인증서를 가져오기 전까지 이 프로파일은 앱 서명에 사용할 수 없습니다."
          }
        }
      }
    },
    "This reinstallation registers the new signature with the OS and will terminate SideStore. You can reopen SideStore immediately once reinstallation is completed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 재설치는 새 서명을 OS에 등록하며 SideStore가 종료됩니다. 재설치가 완료되면 즉시 SideStore를 다시 열 수 있습니다."
          }
        }
      }
    },
    "This version of “%@” requires additional permissions.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 “%@”에는 추가 권한이 필요합니다."
          }
        }
      }
    },
    "This will also erase any backup data for this app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 백업 데이터도 함께 삭제됩니다."
          }
        }
      }
    },
    "This will clear the locally stored private key of this certificate.\n\nName: %@\nS/N: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This will clear the locally stored private key of this certificate.\n\nName: %1$@\nS/N: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인증서의 로컬에 저장된 개인 키가 지워집니다.\n\n이름: %1$@\nS/N: %2$@"
          }
        }
      }
    },
    "This will delete all stored pairing files (both **Lockdown** and **Remote Pairing**). You will need to re-pair or re-import a pairing file and restart SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 페어링 파일(**락다운** 및 **원격 페어링** 모두)이 삭제됩니다. 다시 페어링하거나 페어링 파일을 다시 가져온 뒤 SideStore를 재시작해야 합니다."
          }
        }
      }
    },
    "This will permanently delete all %d provisioning profile(s) for team '%@' on Apple's developer portal. SideStore will automatically generate fresh profiles on next app install or refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This will permanently delete all %1$d provisioning profile(s) for team '%2$@' on Apple's developer portal. SideStore will automatically generate fresh profiles on next app install or refresh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 개발자 포털에서 팀 '%2$@'의 프로비저닝 프로파일 %1$d개가 모두 영구적으로 삭제됩니다. 다음 앱 설치 또는 새로고침 시 SideStore가 새 프로파일을 자동으로 생성합니다."
          }
        }
      }
    },
    "This will remove all temporary files as well as backups for uninstalled apps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 파일과 삭제된 앱의 백업이 모두 제거됩니다."
          }
        }
      }
    },
    "This will remove “%@” from SideStore and erase any backup data for this app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore에서 “%@” 앱이 제거되고, 이 앱의 백업 데이터도 함께 삭제됩니다."
          }
        }
      }
    },
    "This will replace all data you currently have in %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 현재 있는 모든 데이터가 대체됩니다."
          }
        }
      }
    },
    "This will replace any previous backups. Please leave SideStore open until the backup is complete.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 백업이 모두 대체됩니다. 백업이 완료될 때까지 SideStore를 열어 두세요."
          }
        }
      }
    },
    "This will replace your current server catalog with the servers from '%@'. Do you want to proceed?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 서버 카탈로그가 '%@'의 서버로 대체됩니다. 계속하시겠습니까?"
          }
        }
      }
    },
    "This will restore the SideSign headers to their default recommended values.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideSign 헤더를 권장 기본값으로 복원합니다."
          }
        }
      }
    },
    "This will restore the client headers to the default recommended macOS values.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트 헤더가 권장 기본 macOS 값으로 복원됩니다."
          }
        }
      }
    },
    "This will restore the client headers to the default recommended values.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트 헤더를 권장 기본값으로 복원합니다."
          }
        }
      }
    },
    "This will sign you out of Apple ID in SideStore and clear the provisioned adi.pb data from your Keychain. Your active signing certificate will be preserved.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore에서 Apple 계정을 로그아웃하고 Keychain의 프로비저닝된 adi.pb 데이터를 지웁니다. 활성 서명 인증서는 유지됩니다."
          }
        }
      }
    },
