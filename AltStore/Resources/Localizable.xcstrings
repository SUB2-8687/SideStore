    "SideJITServer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer"
          }
        }
      }
    },
    "SideJITServer Detected": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer 감지됨"
          }
        }
      }
    },
    "SideJITServer attaches Apple's debugserver service on macOS to running apps on iOS 17+ over local Wi-Fi or USB.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer는 로컬 Wi-Fi 또는 USB를 통해 macOS의 Apple debugserver 서비스를 iOS 17 이상에서 실행 중인 앱에 연결합니다."
          }
        }
      }
    },
    "SideJITServer is unable to connect to your iDevice. Please make sure you have paired your iDevice by running 'SideJITServer -y', or try refreshing SideJITServer from Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer가 iDevice에 연결할 수 없습니다. 'SideJITServer -y'를 실행하여 iDevice를 페어링했는지 확인하거나, 설정에서 SideJITServer를 새로고침해 보세요."
          }
        }
      }
    },
    "SideSign Client Configuration": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideSign 클라이언트 구성"
          }
        }
      }
    },
    "SideSign Config": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideSign 구성"
          }
        }
      }
    },
    "SideSign JSON configuration saved successfully!": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideSign JSON 구성을 성공적으로 저장했습니다!"
          }
        }
      }
    },
    "SideSign Verbose Logging": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideSign 상세 로깅"
