    "Warning: Delete App ID?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Delete App ID?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: 앱 ID를 삭제하시겠습니까?"
          }
        }
      }
    },
    "Warning: Deleting %1$@%2$@ does not free up an App ID slot.\n\nThis App ID will become reserved and will not be available for use until it expires automatically in %3$d day(s) (from its usual 7-day validity).\n\nAre you sure you want to delete it?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Deleting %1$@%2$@ does not free up an App ID slot.\n\nThis App ID will become reserved and will not be available for use until it expires automatically in %3$d day(s) (from its usual 7-day validity).\n\nAre you sure you want to delete it?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: %1$@%2$@을(를) 삭제해도 앱 ID 슬롯은 확보되지 않습니다.\n\n이 앱 ID는 예약 상태로 남아 있다가, 일반적인 7일 유효 기간이 끝나 %3$d일 뒤 자동으로 만료되면 사용할 수 있게 됩니다.\n\n정말 삭제하시겠습니까?"
          }
        }
      }
    },
    "Warning: Deleting %@%@ does not free up an App ID slot.\n\nThis App ID will become reserved and will not be available for use until it expires automatically after the remaining days of its usual 7-day validity.\n\nAre you sure you want to delete it?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Deleting %@%@ does not free up an App ID slot.\n\nThis App ID will become reserved and will not be available for use until it expires automatically after the remaining days of its usual 7-day validity.\n\nAre you sure you want to delete it?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: %@%@을(를) 삭제해도 앱 ID 슬롯이 확보되지는 않습니다.\n\n이 앱 ID는 예약된 상태가 되며, 일반적인 7일 유효 기간 중 남은 기간이 지나 자동으로 만료될 때까지 사용할 수 없습니다.\n\n정말 삭제하시겠습니까?"
          }
        }
      }
    },
    "Warning: Repeatedly skipping this without completing required verification or terms may lead to your account being restricted by Apple over time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Repeatedly skipping this without completing required verification or terms may lead to your account being restricted by Apple over time."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: 필수 인증 또는 약관을 완료하지 않고 반복적으로 건너뛰면 시간이 지남에 따라 Apple에 의해 계정이 제한될 수 있습니다."
          }
        }
      }
    },
    "We've detected you are using an older anisette server. Using this server has a higher likelihood of locking your account and causing other issues. Are you sure you want to continue?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We've detected you are using an older anisette server. Using this server has a higher likelihood of locking your account and causing other issues. Are you sure you want to continue?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래된 Anisette 서버를 사용 중인 것으로 감지되었습니다. 이 서버를 사용하면 계정이 잠기거나 다른 문제가 발생할 가능성이 높아집니다. 계속하시겠습니까?"
          }
        }
      }
    },
