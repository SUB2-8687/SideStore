            "value" : "앱을 완전히 삭제하려면 홈 화면에서도 삭제해야 합니다."
          }
        }
      }
    },
    "You will need to log back into Apple ID in SideStore." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will need to log back into Apple ID in SideStore."
          }
        },
        "ko" : {
          "stringUnit" : {
