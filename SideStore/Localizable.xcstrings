    "VPN tunnel iface is up but tunnel peer IP is not yet reachable — VPN may not be routing device traffic correctly." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN tunnel iface is up but tunnel peer IP is not yet reachable — VPN may not be routing device traffic correctly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 터널 인터페이스는 활성화되었지만 터널 피어 IP에 아직 연결할 수 없습니다. VPN이 기기 트래픽을 올바르게 라우팅하지 못하고 있을 수 있습니다."
          }
        }
      }
    },
