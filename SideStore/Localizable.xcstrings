      }
    },
    "This item will be permanently removed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This item will be permanently removed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목은 영구적으로 제거됩니다."
          }
        }
      }
    },
    "This provisioning profile contains %@ developer certificate(s), but none match any signing certificates in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This provisioning profile contains %@ developer certificate(s), but none match any signing certificates in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로비저닝 프로파일에는 개발자 인증서 %@개가 들어 있지만, SideStore의 어떤 서명 인증서와도 일치하지 않습니다.\n\n계속하면 개인 키가 있는 일치하는 서명 인증서를 가져오기 전까지 이 프로파일은 앱 서명에 사용할 수 없습니다."
          }
        }
      }
    },
    "This provisioning profile contains %lld developer certificate(s), but none match any signing certificates in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This provisioning profile contains %lld developer certificate(s), but none match any signing certificates in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로비저닝 프로파일에는 개발자 인증서 %lld개가 들어 있지만, SideStore의 어떤 서명 인증서와도 일치하지 않습니다.\n\n계속하면 개인 키가 있는 일치하는 서명 인증서를 가져오기 전까지 이 프로파일은 앱 서명에 사용할 수 없습니다."
          }
        }
      }
    },
    "This reinstallation registers the new signature with the OS and will terminate SideStore. You can reopen SideStore immediately once reinstallation is completed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This reinstallation registers the new signature with the OS and will terminate SideStore. You can reopen SideStore immediately once reinstallation is completed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 재설치는 새 서명을 OS에 등록하며 SideStore가 종료됩니다. 재설치가 완료되면 즉시 SideStore를 다시 열 수 있습니다."
          }
        }
      }
    },
    "This version of “%@” requires additional permissions." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version of “%@” requires additional permissions."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 “%@”에는 추가 권한이 필요합니다."
          }
        }
      }
    },
    "This will also erase any backup data for this app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will also erase any backup data for this app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 백업 데이터도 함께 삭제됩니다."
          }
        }
      }
    },
    "This will clear the locally stored private key of this certificate.\n\nName: %@\nS/N: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will clear the locally stored private key of this certificate.\n\nName: %1$@\nS/N: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 인증서의 로컬에 저장된 개인 키가 지워집니다.\n\n이름: %1$@\nS/N: %2$@"
          }
        }
      }
    },
    "This will delete all stored pairing files (both **Lockdown** and **Remote Pairing**). You will need to re-pair or re-import a pairing file and restart SideStore." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete all stored pairing files (both **Lockdown** and **Remote Pairing**). You will need to re-pair or re-import a pairing file and restart SideStore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 모든 페어링 파일(**락다운** 및 **원격 페어링** 모두)이 삭제됩니다. 다시 페어링하거나 페어링 파일을 다시 가져온 뒤 SideStore를 재시작해야 합니다."
          }
        }
      }
    },
    "This will permanently delete all %d provisioning profile(s) for team '%@' on Apple's developer portal. SideStore will automatically generate fresh profiles on next app install or refresh." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will permanently delete all %1$d provisioning profile(s) for team '%2$@' on Apple's developer portal. SideStore will automatically generate fresh profiles on next app install or refresh."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 개발자 포털에서 팀 '%2$@'의 프로비저닝 프로파일 %1$d개가 모두 영구적으로 삭제됩니다. 다음 앱 설치 또는 새로고침 시 SideStore가 새 프로파일을 자동으로 생성합니다."
          }
        }
      }
    },
    "This will remove all temporary files as well as backups for uninstalled apps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all temporary files as well as backups for uninstalled apps."
