    "Pairing Required:\nWithout a valid pairing file, SideStore operations cannot connect to your device. Please pair your device or import a valid pairing file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing Required:\nWithout a valid pairing file, SideStore operations cannot connect to your device. Please pair your device or import a valid pairing file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링 필요:\n유효한 페어링 파일이 없으면 SideStore 작업이 기기에 연결할 수 없습니다. 기기를 페어링하거나 유효한 페어링 파일을 가져와 주세요."
          }
        }
      }
    },
