          }
        }
      }
    },
    "You do not appear to be connected to VPN.\n\nPlease make sure LocalDevVPN is connected and running! If the issue persists, replace your pairing with iloader or try restarting the device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You do not appear to be connected to VPN.\n\nPlease make sure LocalDevVPN is connected and running! If the issue persists, replace your pairing with iloader or try restarting the device."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN에 연결되어 있지 않은 것 같습니다.\n\nLocalDevVPN이 연결되어 실행 중인지 확인하세요! 문제가 계속되면 iloader로 페어링을 다시 설정하거나 기기를 재시작해 보세요."
          }
        }
      }
    },
    "You do not appear to be connected to Wi-Fi!\n\nPlease connect to a Wi-Fi before attempting futher operations" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You do not appear to be connected to Wi-Fi!\n\nPlease connect to a Wi-Fi before attempting futher operations"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi에 연결되어 있지 않은 것 같습니다!\n\n추가 작업을 시도하기 전에 Wi-Fi에 연결해 주세요"
          }
        }
      }
    },
    "You must add this source before installing apps from it.\n\n“%@” will begin downloading once it has been added." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must add this source before installing apps from it.\n\n“%@” will begin downloading once it has been added."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소의 앱을 설치하려면 먼저 저장소를 추가해야 합니다.\n\n저장소를 추가하면 “%@” 다운로드가 시작됩니다."
          }
        }
      }
    },
    "You must also delete it from the home screen to fully uninstall the app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must also delete it from the home screen to fully uninstall the app."
