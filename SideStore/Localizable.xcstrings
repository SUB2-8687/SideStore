        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No unexpired provisioning profiles matching '%@' with an imported signing certificate (.p12) were found locally.\n\nPlease go to Settings -> Profiles Management to import and configure a profile with its matching certificate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 서명 인증서(.p12)가 있고 '%@'과(와) 일치하는 만료되지 않은 프로비저닝 프로파일을 로컬에서 찾을 수 없습니다.\n\n설정 -> 프로파일 관리에서 일치하는 인증서가 있는 프로파일을 가져와 구성하세요."
          }
        }
      }
    },
    "No valid migration path exists to downgrade this database. Please update SideStore or reset your database." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No valid migration path exists to downgrade this database. Please update SideStore or reset your database."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 데이터베이스를 다운그레이드할 수 있는 유효한 마이그레이션 경로가 없습니다. SideStore를 업데이트하거나 데이터베이스를 재설정하세요."
          }
        }
      }
    },
    "No valid signing certificates with private keys were found locally. Please import or create a certificate in Settings -> Certificates first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No valid signing certificates with private keys were found locally. Please import or create a certificate in Settings -> Certificates first."
