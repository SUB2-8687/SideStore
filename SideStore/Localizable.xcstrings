    "Found certificate '%@' in this profile, but no matching private key (.p12) was found in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Found certificate '%@' in this profile, but no matching private key (.p12) was found in SideStore.\n\nContinuing means this profile will not be usable for signing apps until a matching signing certificate with private key is imported."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로파일에서 '%@' 인증서를 찾았지만, SideStore에서 일치하는 개인 키(.p12)를 찾을 수 없습니다.\n\n계속하면 개인 키가 있는 일치하는 서명 인증서를 가져오기 전까지 이 프로파일은 앱 서명에 사용할 수 없습니다."
          }
        }
      }
    },
    "Found matching signing certificate '%@' with private key in SideStore.\n\nWould you like to link and save this profile?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Found matching signing certificate '%@' with private key in SideStore.\n\nWould you like to link and save this profile?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideStore에서 개인 키가 있는 일치하는 서명 '%@' 인증서를 찾았습니다.\n\n이 프로파일을 연결하고 저장하시겠습니까?"
          }
        }
      }
    },
